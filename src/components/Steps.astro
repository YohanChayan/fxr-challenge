---
const steps = ['Sign up with email', 'Pick a market and date', 'Build your edge'];
---

<section class="steps" aria-labelledby="steps-title">
  <div class="inner">
    <h2 id="steps-title">How it works</h2>
    <ol>
      {steps.map((step, index) => (
        <li>
          <span class="number" aria-hidden="true">
            {index + 1}
          </span>
          <span class="label">{step}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    background: var(--bg-secondary);
    border-block: 1px solid var(--border-primary);
  }

  .inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 56px 16px;
  }

  h2 {
    font-size: clamp(1.625rem, 1.3rem + 1.4vw, 2.25rem);
    margin-bottom: 24px;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px;
    background: var(--card-bg-primary);
    border: 1px solid var(--border-secondary);
    border-radius: 12px;
    color: var(--card-text-primary);
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .number {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border-brand);
    color: var(--text-brand-small);
    font-family: var(--font-display);
  }

  @media (min-width: 768px) {
    .inner {
      padding: 80px 32px;
    }

    ol {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    li {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px;
    }
  }
</style>
