# Production. Copy to /srv/platform/caddy/sites/ on the server, then reload Caddy. Point the DNS
# record at the host first, so the first certificate attempt does not fail and back off.
fxr-challenge.yhndevside.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-Via
	}

	reverse_proxy fxr-challenge-web:4321
}
